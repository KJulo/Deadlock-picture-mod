---
import Plate from './Plate.astro';
import { useDict } from '../i18n/ui';
const t = useDict(Astro.currentLocale);
const numerals = ['I', 'II', 'III'];
---
<section id="instalar" class="install wrap" aria-labelledby="instalar-title">
  <Plate as="div">
    <h2 id="instalar-title">{t.install.title}</h2>
    <ol class="steps">
      {t.install.steps.map((step, i) => (
        <li>
          <span class="numeral" aria-hidden="true">{numerals[i]}</span>
          <p set:html={step} />
        </li>
      ))}
    </ol>
    <pre><code>sv_cheats 1
citadel_give_gold 5000 1
kill</code></pre>
  </Plate>
</section>
<style>
  .install { padding-block: 32px; max-width: 760px; }
  h2 { font-size: clamp(1.8rem, 3vw, 2.4rem); margin-bottom: 20px; }
  .steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  .steps li { display: grid; grid-template-columns: auto 1fr; gap: 16px; align-items: baseline; }
  .steps p { margin: 0; }
  .numeral {
    font-family: var(--font-display); color: var(--parchment); background: var(--teal-deep);
    min-width: 2.1em; padding: 0.1em 0.4em; text-align: center;
    clip-path: polygon(12% 0, 88% 0, 100% 50%, 88% 100%, 12% 100%, 0 50%);
  }
  code { color: var(--teal-deep); }
  pre {
    margin: 16px 0 0; padding: 14px 20px; overflow-x: auto;
    background: var(--night); color: var(--soul); border-left: 3px solid var(--brass);
  }
  pre code { color: inherit; font-size: 0.95rem; line-height: 1.7; }
</style>
