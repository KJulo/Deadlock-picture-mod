---
import { useDict } from '../i18n/ui';
const t = useDict(Astro.currentLocale);
---
<section id="instalar" class="install wrap" aria-labelledby="instalar-title">
  <h2 id="instalar-title" class="section-title">{t.install.title}</h2>
  <div class="card">
    <ol class="steps">
      {t.install.steps.map((step, i) => (
        <li>
          <span class="num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <p set:html={step} />
        </li>
      ))}
    </ol>
    <pre><code>sv_cheats 1
citadel_give_gold 5000 1
kill</code></pre>
  </div>
</section>
<style>
  .install { padding-block: clamp(40px, 6vw, 72px) 24px; max-width: 860px; }
  .card { padding: 0; }
  .steps { list-style: none; margin: 0; padding: 0; }
  .steps li {
    display: grid; grid-template-columns: 56px 1fr; gap: 18px; align-items: baseline;
    padding: 16px clamp(18px, 3vw, 28px); border-bottom: 1px solid var(--line);
  }
  .num { font: 700 1.6rem/1 var(--font-caps); color: var(--gold); }
  .steps p { margin: 0; color: var(--cream-2); }
  .steps :global(strong) { color: var(--cream); font-weight: 500; }
  .steps :global(code) { color: var(--gold-bright); background: var(--ink-3); padding: 1px 5px; }
  pre {
    margin: 0; padding: 18px clamp(18px, 3vw, 28px); overflow-x: auto;
    background: var(--ink-0); color: var(--soul);
  }
  pre code { font-size: 0.95rem; line-height: 1.8; }
</style>
