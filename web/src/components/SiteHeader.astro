---
import { SITE } from '../site.js';
import { languages, defaultLang, useDict, fmt, homeUrl, type Lang } from '../i18n/ui';
const t = useDict(Astro.currentLocale);
const current = (Astro.currentLocale ?? defaultLang) as Lang;
---
<header class="site-header wrap">
  <a class="mark" href={homeUrl(current)} aria-label={fmt(t.header.home, { name: SITE.name })}>
    <svg viewBox="0 0 40 40" aria-hidden="true">
      <path d="M20 2 38 20 20 38 2 20Z" />
      <circle cx="20" cy="20" r="7" />
    </svg>
    <span class="name">{SITE.name}</span>
  </a>
  <div class="right">
    <nav aria-label={t.header.sections}>
      <a class="caps" href="#taller">{t.header.workshop}</a>
      <a class="caps" href="#instalar">{t.header.install}</a>
      <a class="caps" href="#preguntas">{t.header.faq}</a>
    </nav>
    <nav class="langs" aria-label={t.header.language}>
      {(Object.keys(languages) as Lang[]).map((l) => (
        <a class="caps" href={homeUrl(l)} hreflang={l} lang={l} title={languages[l]}
           aria-current={l === current ? 'page' : undefined}>{l.toUpperCase()}</a>
      ))}
    </nav>
  </div>
</header>
<style>
  .site-header { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding-block: 22px; }
  .mark { display: flex; align-items: center; gap: 12px; text-decoration: none; }
  .mark svg { width: 34px; height: 34px; }
  .mark path { fill: none; stroke: var(--brass-bright); stroke-width: 1.6; }
  .mark circle { fill: var(--teal); stroke: var(--soul); stroke-width: 1.4; }
  .name { font-family: var(--font-display); font-size: 1.6rem; letter-spacing: 0.06em; color: var(--parchment); }
  nav { display: flex; gap: clamp(12px, 3vw, 32px); }
  nav a { text-decoration: none; color: var(--parchment-3); }
  nav a:hover { color: var(--soul); }
  .right { display: flex; align-items: center; gap: clamp(16px, 4vw, 40px); }
  .langs { gap: 4px; padding-left: clamp(12px, 3vw, 28px); border-left: 1px solid var(--brass-dark); }
  .langs a { padding: 2px 6px; }
  .langs a[aria-current='page'] { color: var(--brass-bright); pointer-events: none; }
  @media (max-width: 560px) { nav:not(.langs) { display: none; } .langs { border-left: 0; padding-left: 0; } }
</style>
