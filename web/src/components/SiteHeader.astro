---
import { SITE } from '../site.js';
import { languages, defaultLang, useDict, fmt, homeUrl, type Lang } from '../i18n/ui';
const t = useDict(Astro.currentLocale);
const current = (Astro.currentLocale ?? defaultLang) as Lang;
---
<header class="site-header">
  <div class="bar wrap">
    <a class="mark" href={homeUrl(current)} aria-label={fmt(t.header.home, { name: SITE.name })}>
      <svg viewBox="0 0 40 40" aria-hidden="true">
        <circle cx="20" cy="20" r="15" class="ring" />
        <circle cx="20" cy="20" r="6.5" class="soul" />
      </svg>
      <span class="name">{SITE.name}</span>
    </a>
    <nav class="links" aria-label={t.header.sections}>
      <a class="caps" href="#taller">{t.header.workshop}</a>
      <a class="caps" href="#instalar">{t.header.install}</a>
      <a class="caps" href="#preguntas">{t.header.faq}</a>
    </nav>
    <nav class="langs" aria-label={t.header.language}>
      {(Object.keys(languages) as Lang[]).map((l) => (
        <a class="caps" href={homeUrl(l)} hreflang={l} lang={l} title={languages[l]}
           aria-current={l === current ? 'page' : undefined}>{l.toUpperCase()}</a>
      ))}
    </nav>
  </div>
</header>
<style>
  .site-header {
    position: sticky; top: 0; z-index: 50;
    background: rgba(17, 16, 15, 0.78);
    -webkit-backdrop-filter: blur(12px) saturate(1.1); backdrop-filter: blur(12px) saturate(1.1);
    box-shadow: inset 0 4px 0 var(--gold);
    border-bottom: 1px solid rgba(196, 156, 71, 0.3);
  }
  .bar { display: flex; align-items: center; gap: clamp(16px, 4vw, 40px); height: 64px; padding-top: 4px; }
  .mark { display: flex; align-items: center; gap: 10px; text-decoration: none; flex: none; }
  .mark svg { width: 32px; height: 32px; }
  .ring { fill: none; stroke: var(--gold); stroke-width: 3; }
  .soul { fill: var(--soul); filter: drop-shadow(0 0 4px rgba(41, 255, 201, 0.7)); }
  .name { font-family: var(--font-display); font-weight: 800; font-size: 1.55rem; line-height: 1; color: var(--cream); }
  .mark:hover .name { color: var(--gold-bright); }

  .links { display: flex; gap: clamp(14px, 2.5vw, 28px); margin-inline: auto; }
  .links a {
    font-size: 1.02rem; text-decoration: none; color: var(--cream);
    padding: 4px 0; border-bottom: 2px solid transparent; transition: color 0.2s, border-color 0.2s;
  }
  .links a:hover { color: var(--gold); border-bottom-color: var(--gold); }

  .langs { display: flex; gap: 6px; flex: none; }
  .langs a {
    display: grid; place-items: center; min-width: 38px; height: 32px; padding: 0 8px;
    text-decoration: none; color: var(--cream); border: 1px solid var(--gold-dim); transition: border-color 0.2s, color 0.2s;
  }
  .langs a:hover { border-color: var(--gold); color: var(--gold); }
  .langs a[aria-current='page'] { background: var(--gold); border-color: var(--gold); color: var(--ink-1); pointer-events: none; }
  @media (max-width: 620px) { .links { display: none; } .langs { margin-left: auto; } }
</style>
