---
import { SITE } from '../site.js';
import { useDict } from '../i18n/ui';
import Divider from './Divider.astro';
const t = useDict(Astro.currentLocale);
---
<footer class="site-footer wrap">
  <Divider />
  <p>{t.footer.disclaimer}</p>
  <p class="caps"><a href={SITE.repo}>{t.footer.code}</a></p>
</footer>
<style>
  .site-footer { text-align: center; padding-block: 48px 64px; color: var(--parchment-3); display: grid; gap: 18px; }
  p { margin: 0 auto; max-width: 62ch; font-size: 1rem; }
</style>
