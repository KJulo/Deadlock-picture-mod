---
import { useDict } from '../i18n/ui';
const t = useDict(Astro.currentLocale);
---
<section id="preguntas" class="faq wrap" aria-labelledby="preguntas-title">
  <h2 id="preguntas-title" class="section-title">{t.faq.title}</h2>
  <div class="list">
    {t.faq.items.map(([q, a]) => (
      <details>
        <summary>{q}</summary>
        <p>{a}</p>
      </details>
    ))}
  </div>
</section>
<style>
  .faq { padding-block: 40px 24px; max-width: 860px; }
  .list { display: grid; gap: 8px; }
  details { background: var(--ink-2); border: 1px solid var(--line); border-left: 3px solid var(--gold-dim); transition: border-color 0.2s; }
  details[open], details:hover { border-left-color: var(--gold); }
  summary {
    cursor: pointer; list-style: none; padding: 15px 52px 15px 20px; position: relative;
    font: 600 1.25rem/1.25 var(--font-display); color: var(--cream);
  }
  summary::-webkit-details-marker { display: none; }
  summary::after {
    content: '+'; position: absolute; right: 18px; top: 50%; transform: translateY(-50%);
    font: 600 1.6rem/1 var(--font-caps); color: var(--gold); transition: transform 0.2s;
  }
  details[open] summary::after { transform: translateY(-50%) rotate(45deg); }
  summary:hover { color: var(--gold-bright); }
  details p { margin: 0; padding: 0 20px 18px; color: var(--cream-2); max-width: 68ch; }
</style>
