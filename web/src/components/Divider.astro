---
// Art deco rule: stepped lines converging on a diamond.
interface Props { tone?: 'brass' | 'ink' }
const { tone = 'brass' } = Astro.props;
---
<div class:list={['divider', tone]} aria-hidden="true">
  <svg viewBox="0 0 400 20" preserveAspectRatio="none">
    <path d="M0 10H170M176 6H186M176 14H186M214 6H224M214 14H224M230 10H400" />
    <path d="M200 1 209 10 200 19 191 10Z" class="gem" />
    <path d="M200 6 204 10 200 14 196 10Z" class="core" />
  </svg>
</div>
<style>
  .divider { width: min(420px, 100%); margin: 0 auto; height: 20px; }
  svg { width: 100%; height: 100%; overflow: visible; }
  path { fill: none; stroke-width: 1.25; vector-effect: non-scaling-stroke; }
  .brass path { stroke: var(--brass); }
  .ink path { stroke: var(--brass-dark); }
  .core { fill: var(--soul); stroke: none !important; }
  .ink .core { fill: var(--teal); }
</style>
