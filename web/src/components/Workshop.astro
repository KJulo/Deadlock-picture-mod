---
import Plate from './Plate.astro';
import { useDict } from '../i18n/ui';

const t = useDict(Astro.currentLocale);
const w = t.workshop;
const sw = w.swatches;

// Presets for the colour pickers: [name, hex]
const backgrounds = [
  [sw.soul, '#18788c'], [sw.abyss, '#0f2f3a'], [sw.brass, '#8a6a3a'],
  [sw.blood, '#6e1f1f'], [sw.bone, '#d9cfb8'], [sw.onyx, '#151515'],
];
const rings = [[sw.bone, '#ebebeb'], [sw.brass, '#c9a45c'], [sw.onyx, '#141414'], [sw.soul, '#29ffc9']];
const layouts = (['cube6', 'twice', 'wrap'] as const).map((value) => ({ value, ...w.layouts[value] }));
// Runtime strings for the script below.
const messages = { status: t.status, errors: t.errors };
---
<section id="taller" class="workshop wrap" aria-labelledby="taller-title" data-messages={JSON.stringify(messages)}>
  <div class="stage">
    <div class="arch">
      <canvas id="view" aria-label={w.canvas}></canvas>
      <div class="overlay" id="overlay" hidden></div>
    </div>
    <div class="viewer-controls" role="group" aria-label={w.viewerOptions}>
      <label><input type="checkbox" id="opt-spin" checked /> <span class="caps">{w.spin}</span></label>
      <label><input type="checkbox" id="opt-effects" checked /> <span class="caps">{w.effects}</span></label>
      <label><input type="checkbox" id="opt-pulse" checked /> <span class="caps">{w.pulse}</span></label>
      <label><input type="checkbox" id="opt-outline" checked /> <span class="caps">{w.outline}</span></label>
      <label class="lod">
        <span class="caps">{w.lod}</span>
        <select id="opt-lod">
          {w.lods.map((name, i) => <option value={i}>{name}</option>)}
        </select>
      </label>
    </div>
    <p class="note">{w.note}</p>
  </div>

  <Plate class="bench" labelledby="taller-title">
    <h2 id="taller-title" class="visually-hidden">{w.title}</h2>
    <ol class="acts">
      <li class="act">
        <h3><span class="numeral" aria-hidden="true">I</span> {w.photo}</h3>
        <label class="drop" id="drop">
          <input type="file" id="photo" accept="image/jpeg,image/png,image/webp,image/gif" class="visually-hidden" />
          <span class="drop-text">
            <Fragment set:html={w.dropHtml} />
            <span class="caps small">{w.formats} <span id="max-mb">15</span> MB</span>
          </span>
        </label>
        <button type="button" class="link" id="sample">{w.sample}</button>

        <div class="framing" id="framing" hidden>
          <div class="thumb" id="thumb">
            <img id="thumb-img" alt={w.thumbAlt} />
            <div class="disc" id="disc" aria-hidden="true"></div>
          </div>
          <p class="hint">{w.hint}</p>
          <label class="range">
            <span class="caps">{w.framing}</span>
            <input type="range" id="radius" min="0.2" max="1" step="0.02" value="0.5" />
          </label>
        </div>
      </li>

      <li class="act">
        <h3><span class="numeral" aria-hidden="true">II</span> {w.shape}</h3>
        <fieldset class="layouts">
          <legend class="visually-hidden">{w.layoutLegend}</legend>
          {layouts.map((l, i) => (
            <label class="layout">
              <input type="radio" name="layout" value={l.value} checked={i === 0} />
              <svg viewBox="0 0 48 48" aria-hidden="true">
                <circle cx="24" cy="24" r="21" class="ball" />
                {l.value === 'cube6' && (<g class="seal"><circle cx="24" cy="24" r="7" /><circle cx="9" cy="24" r="4" /><circle cx="39" cy="24" r="4" /><circle cx="24" cy="9" r="4" /><circle cx="24" cy="39" r="4" /></g>)}
                {l.value === 'twice' && (<g class="seal"><circle cx="24" cy="24" r="12" /></g>)}
                {l.value === 'wrap' && (<g class="seal"><ellipse cx="24" cy="24" rx="21" ry="21" /></g>)}
              </svg>
              <span class="layout-name">{l.name}</span>
              <span class="layout-note">{l.note}</span>
            </label>
          ))}
        </fieldset>
        <div class="sticker-opts" id="sticker-opts">
          <label class="range">
            <span class="caps">{w.stickerSize}</span>
            <input type="range" id="sticker_deg" min="20" max="45" step="1" value="40" />
          </label>
          <label class="range">
            <span class="caps">{w.ringWidth}</span>
            <input type="range" id="ring_deg" min="0" max="8" step="0.5" value="3" />
          </label>
        </div>
      </li>

      <li class="act">
        <h3><span class="numeral" aria-hidden="true">III</span> {w.colors}</h3>
        <fieldset class="swatches">
          <legend class="caps">{w.background}</legend>
          {backgrounds.map(([name, hex], i) => (
            <label class="swatch" title={name}>
              <input type="radio" name="bg" value={hex} checked={i === 0} />
              <span style={`--c:${hex}`}></span><span class="visually-hidden">{name}</span>
            </label>
          ))}
          <label class="swatch custom" title={w.otherColor}>
            <input type="color" id="bg-custom" value="#18788c" />
            <span class="visually-hidden">{w.otherBackground}</span>
          </label>
        </fieldset>
        <fieldset class="swatches" id="ring-colors">
          <legend class="caps">{w.ring}</legend>
          {rings.map(([name, hex], i) => (
            <label class="swatch" title={name}>
              <input type="radio" name="ring" value={hex} checked={i === 0} />
              <span style={`--c:${hex}`}></span><span class="visually-hidden">{name}</span>
            </label>
          ))}
        </fieldset>
      </li>

      <li class="act">
        <h3><span class="numeral" aria-hidden="true">IV</span> {w.forgeTitle}</h3>
        <button type="button" class="forge" id="forge" disabled>
          <span>{w.forgeButton}</span>
        </button>
        <p class="status" id="status" role="status" aria-live="polite">{t.status.needPhoto}</p>
      </li>
    </ol>
  </Plate>
</section>

<script>
  import { createApi } from '../lib/preview/api.js';

  // Localized strings, rendered into the section by the server (see `messages` above).
  const M: { status: Record<string, string>; errors: Record<string, string> } =
    JSON.parse(document.getElementById('taller')!.dataset.messages!);
  const msg = (key: string, vars: Record<string, string | number> = {}) =>
    M.status[key].replace(/\{(\w+)\}/g, (m, k) => (k in vars ? String(vars[k]) : m));
  // Backend errors carry a stable code; show our translation when we have one.
  const errorText = (e: any) => (e.code && M.errors[e.code]) || e.message;

  const api = createApi(import.meta.env.PUBLIC_API_BASE || 'http://localhost:8080');
  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
  const status = (text: string, error = false) => {
    $('status').textContent = text;
    $('status').classList.toggle('error', error);
  };
  const overlay = (text: string | null) => {
    $('overlay').hidden = !text;
    $('overlay').textContent = text ?? '';
  };

  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
  let viewer: any = null; // the 3D viewer (three.js is loaded lazily, after the page shows)
  let maxBytes = 15 << 20;
  let photo: Blob | null = null;
  const center = { x: 0.5, y: 0.5 };
  let inflight: AbortController | null = null;
  let timer = 0;

  // --- viewer --------------------------------------------------------------------------------
  async function init() {
  try {
    const [{ createViewer }, mesh, defaults] = await Promise.all([
      import('../lib/preview/viewer.js'), api.mesh(0), api.defaults(),
    ]);
    maxBytes = defaults.max_upload_bytes;
    $('max-mb').textContent = String(Math.round(maxBytes / (1 << 20)));
    viewer = createViewer($<HTMLCanvasElement>('view'), { mesh, background: 0x0e1719 });
    if (reducedMotion) { viewer.set({ spin: false }); $<HTMLInputElement>('opt-spin').checked = false; }
    const sample = await fetch('/sample-texture.jpg');
    if (sample.ok) await viewer.setTextureBlob(await sample.blob());
  } catch {
    overlay(msg('offline'));
    status(msg('noServer'), true);
  }
  }
  init();

  for (const opt of ['spin', 'effects', 'pulse', 'outline'] as const) {
    $<HTMLInputElement>(`opt-${opt}`).addEventListener('change', (e) =>
      viewer?.set({ [opt]: (e.target as HTMLInputElement).checked }));
  }
  $<HTMLSelectElement>('opt-lod').addEventListener('change', async (e) => {
    viewer?.setMesh(await api.mesh(+(e.target as HTMLSelectElement).value));
  });

  // --- parameters ----------------------------------------------------------------------------
  const hex = (v: string) => [1, 3, 5].map((i) => parseInt(v.slice(i, i + 2), 16));
  const checked = (name: string) =>
    (document.querySelector(`input[name="${name}"]:checked`) as HTMLInputElement | null)?.value;
  let bgCustom: string | null = null;

  function params() {
    return {
      layout: checked('layout'),
      center: [center.x, center.y],
      radius: +$<HTMLInputElement>('radius').value,
      sticker_deg: +$<HTMLInputElement>('sticker_deg').value,
      ring_deg: +$<HTMLInputElement>('ring_deg').value,
      bg_color: hex(bgCustom ?? checked('bg') ?? '#18788c'),
      ring_color: hex(checked('ring') ?? '#ebebeb'),
    };
  }

  async function refresh() {
    if (!photo || !viewer) return;
    inflight?.abort();
    inflight = new AbortController();
    status(msg('rendering'));
    try {
      await viewer.setTextureBlob(await api.texture(photo, params(), 2048, inflight.signal));
      status(msg('ready'));
    } catch (e: any) {
      if (e.name !== 'AbortError') status(errorText(e), true);
    }
  }
  const later = () => { clearTimeout(timer); timer = window.setTimeout(refresh, 250); };

  function syncLayout() {
    const layout = checked('layout');
    $('sticker-opts').hidden = layout === 'wrap';
    $('ring-colors').hidden = layout === 'wrap';
  }
  document.querySelectorAll('input[name="layout"]').forEach((el) =>
    el.addEventListener('change', () => { syncLayout(); later(); }));
  document.querySelectorAll('input[name="bg"]').forEach((el) =>
    el.addEventListener('change', () => { bgCustom = null; later(); }));
  document.querySelectorAll('input[name="ring"]').forEach((el) => el.addEventListener('change', later));
  $<HTMLInputElement>('bg-custom').addEventListener('input', (e) => {
    bgCustom = (e.target as HTMLInputElement).value;
    document.querySelectorAll<HTMLInputElement>('input[name="bg"]').forEach((r) => (r.checked = false));
    later();
  });
  for (const id of ['sticker_deg', 'ring_deg']) $(id).addEventListener('input', later);
  $('radius').addEventListener('input', () => { drawDisc(); later(); });

  // --- photo + framing -----------------------------------------------------------------------
  const img = $<HTMLImageElement>('thumb-img');

  function drawDisc() {
    const w = img.clientWidth, h = img.clientHeight;
    if (!w || !h) return;
    const r = +$<HTMLInputElement>('radius').value * Math.min(w, h);
    Object.assign($('disc').style, {
      width: `${2 * r}px`, height: `${2 * r}px`,
      left: `${center.x * w - r}px`, top: `${center.y * h - r}px`,
    });
  }

  function usePhoto(file: Blob) {
    if (file.size > maxBytes) {
      status(msg('tooBig', { size: (file.size / 1e6).toFixed(1), max: Math.round(maxBytes / (1 << 20)) }), true);
      return;
    }
    photo = file;
    center.x = center.y = 0.5;
    if (img.src) URL.revokeObjectURL(img.src);
    img.src = URL.createObjectURL(file);
    img.onload = drawDisc;
    $('framing').hidden = false;
    $<HTMLButtonElement>('forge').disabled = false;
    refresh();
  }

  $<HTMLInputElement>('photo').addEventListener('change', (e) => {
    const f = (e.target as HTMLInputElement).files?.[0];
    if (f) usePhoto(f);
  });
  $('sample').addEventListener('click', async () => usePhoto(await (await fetch('/sample.jpg')).blob()));

  const drop = $('drop');
  drop.addEventListener('dragover', (e) => { e.preventDefault(); drop.classList.add('over'); });
  drop.addEventListener('dragleave', () => drop.classList.remove('over'));
  drop.addEventListener('drop', (e) => {
    e.preventDefault();
    drop.classList.remove('over');
    const f = e.dataTransfer?.files?.[0];
    if (f) usePhoto(f);
  });

  // drag the disc (pointer events cover mouse, touch and pen)
  const thumb = $('thumb');
  function pick(e: PointerEvent) {
    const r = img.getBoundingClientRect();
    center.x = Math.min(1, Math.max(0, (e.clientX - r.left) / r.width));
    center.y = Math.min(1, Math.max(0, (e.clientY - r.top) / r.height));
    drawDisc();
    later();
  }
  thumb.addEventListener('pointerdown', (e) => { thumb.setPointerCapture(e.pointerId); pick(e); });
  thumb.addEventListener('pointermove', (e) => { if (thumb.hasPointerCapture(e.pointerId)) pick(e); });
  addEventListener('resize', drawDisc);

  // --- forge ---------------------------------------------------------------------------------
  $('forge').addEventListener('click', async () => {
    if (!photo) return;
    const button = $<HTMLButtonElement>('forge');
    button.disabled = true;
    status(msg('forging'));
    try {
      const blob = await api.build(photo, params());
      const a = Object.assign(document.createElement('a'), {
        href: URL.createObjectURL(blob), download: 'relicario_soul_container.vpk',
      });
      a.click();
      setTimeout(() => URL.revokeObjectURL(a.href), 1000);
      status(msg('done'));
    } catch (e: any) {
      status(errorText(e), true);
    } finally {
      button.disabled = false;
    }
  });
</script>

<style>
  .workshop {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: clamp(24px, 4vw, 56px);
    align-items: start;
    padding-block: 24px 64px;
  }

  /* ---------- the stage: viewer inside a deco arch ---------- */
  .stage { position: sticky; top: 24px; display: grid; gap: 14px; }
  .arch {
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: 999px 999px 4px 4px / 46% 46% 4px 4px;
    overflow: hidden;
    background: radial-gradient(ellipse at 50% 40%, #183238, var(--night) 70%);
    box-shadow:
      0 0 0 1px var(--brass),
      0 0 0 7px var(--night),
      0 0 0 8px var(--brass-dark),
      0 40px 80px -40px rgba(41, 255, 201, 0.25);
  }
  .arch::after { /* inner keyline following the arch */
    content: '';
    position: absolute;
    inset: 10px;
    border: 1px solid rgba(216, 182, 118, 0.35);
    border-radius: inherit;
    pointer-events: none;
  }
  canvas { width: 100%; height: 100%; touch-action: none; cursor: grab; }
  canvas:active { cursor: grabbing; }
  .overlay {
    position: absolute; inset: 0; display: grid; place-items: center; padding: 15%;
    text-align: center; font-style: italic; font-size: 1.25rem; color: var(--parchment-2);
    background: rgba(14, 23, 25, 0.75);
  }
  .viewer-controls { display: flex; flex-wrap: wrap; gap: 8px 18px; justify-content: center; color: var(--parchment-2); }
  .viewer-controls label { display: inline-flex; align-items: center; gap: 6px; cursor: pointer; }
  .viewer-controls input { accent-color: var(--soul); }
  .viewer-controls select {
    background: transparent; color: var(--parchment); border: 1px solid var(--brass-dark);
    font: inherit; font-size: 0.95rem; padding: 2px 6px;
  }
  .viewer-controls option { color: #000; }
  .note { margin: 0; text-align: center; font-style: italic; font-size: 0.98rem; color: var(--parchment-3); }

  /* ---------- the bench: numbered acts ---------- */
  .acts { list-style: none; margin: 0; padding: 0; display: grid; gap: 30px; }
  .act + .act { padding-top: 26px; border-top: 1px solid rgba(111, 84, 48, 0.35); }
  .act h3 { display: flex; align-items: baseline; gap: 14px; font-size: 1.7rem; margin-bottom: 14px; }
  .numeral {
    font-family: var(--font-display); font-size: 1.1rem; color: var(--parchment);
    background: var(--teal-deep); min-width: 2.1em; padding: 0.15em 0.4em; text-align: center;
    clip-path: polygon(12% 0, 88% 0, 100% 50%, 88% 100%, 12% 100%, 0 50%);
  }
  .small { display: block; margin-top: 6px; font-size: 0.68rem; color: var(--ink-soft); }

  .drop {
    display: grid; place-items: center; text-align: center; min-height: 120px; padding: 18px;
    border: 1.5px dashed var(--brass); background: rgba(255, 255, 255, 0.25); cursor: pointer;
    transition: background 0.2s, border-color 0.2s;
  }
  .drop:hover, .drop.over { background: rgba(24, 120, 140, 0.12); border-color: var(--teal); }
  .drop:focus-within { outline: 2px solid var(--teal); outline-offset: 3px; }
  .drop strong { font-size: 1.25rem; }
  .link {
    margin-top: 8px; padding: 0; border: 0; background: none; font: italic 1rem var(--font-serif);
    color: var(--teal-deep); text-decoration: underline; text-decoration-color: var(--brass); cursor: pointer;
  }

  .framing { margin-top: 18px; display: grid; gap: 10px; }
  .thumb { position: relative; justify-self: start; max-width: 100%; touch-action: none; cursor: crosshair; user-select: none; }
  .thumb img { max-height: 240px; width: auto; box-shadow: 0 0 0 1px var(--brass-dark); pointer-events: none; }
  .disc {
    position: absolute; border-radius: 50%;
    border: 2px solid var(--parchment);
    box-shadow: 0 0 0 1px var(--ink), 0 0 0 9999px rgba(14, 23, 25, 0.45);
    pointer-events: none;
  }
  .thumb { overflow: hidden; }
  .hint { margin: 0; font-style: italic; font-size: 0.98rem; color: var(--ink-soft); }

  .range { display: grid; gap: 6px; }
  input[type='range'] { width: 100%; accent-color: var(--teal); }

  .layouts { border: 0; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
  .layout {
    position: relative; display: grid; justify-items: center; gap: 4px; text-align: center;
    padding: 12px 8px; cursor: pointer; border: 1px solid rgba(111, 84, 48, 0.45);
    background: rgba(255, 255, 255, 0.2); transition: background 0.2s, border-color 0.2s;
  }
  .layout input { position: absolute; opacity: 0; }
  .layout svg { width: 48px; height: 48px; }
  .layout .ball { fill: var(--teal); stroke: var(--brass-dark); }
  .layout .seal circle, .layout .seal ellipse { fill: var(--parchment); stroke: var(--ink); stroke-width: 1; }
  .layout-name { font-weight: 600; font-size: 1.05rem; }
  .layout-note { font-size: 0.88rem; line-height: 1.3; color: var(--ink-soft); }
  .layout:has(input:checked) { border-color: var(--teal-deep); background: rgba(24, 120, 140, 0.14); box-shadow: inset 0 0 0 1px var(--teal-deep); }
  .layout:has(input:focus-visible) { outline: 2px solid var(--teal); outline-offset: 2px; }
  .sticker-opts { margin-top: 16px; display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }

  .swatches { border: 0; margin: 0 0 14px; padding: 0; display: flex; flex-wrap: wrap; align-items: center; gap: 10px; }
  .swatches legend { margin-bottom: 8px; color: var(--ink-soft); }
  .swatch { position: relative; cursor: pointer; }
  .swatch input[type='radio'] { position: absolute; opacity: 0; }
  .swatch span:not(.visually-hidden) {
    display: block; width: 34px; height: 34px; background: var(--c);
    transform: rotate(45deg) scale(0.78); box-shadow: 0 0 0 1px var(--ink); transition: transform 0.15s;
  }
  .swatch:has(input:checked) span:not(.visually-hidden) { box-shadow: 0 0 0 2px var(--parchment), 0 0 0 4px var(--teal-deep); transform: rotate(45deg) scale(0.86); }
  .swatch:has(input:focus-visible) span { outline: 2px solid var(--teal); outline-offset: 4px; }
  .swatch.custom input { width: 34px; height: 34px; padding: 0; border: 1px solid var(--ink); background: none; cursor: pointer; }

  .forge {
    width: 100%; padding: 16px 24px; border: 0; cursor: pointer;
    font: 600 0.95rem var(--font-caps); letter-spacing: 0.24em; text-transform: uppercase;
    color: var(--parchment); background: linear-gradient(180deg, #12596a, var(--teal-deep));
    clip-path: polygon(14px 0, calc(100% - 14px) 0, 100% 50%, calc(100% - 14px) 100%, 14px 100%, 0 50%);
    transition: filter 0.2s;
  }
  .forge span { display: block; padding: 2px 0; border-block: 1px solid rgba(216, 182, 118, 0.6); }
  .forge:hover:not(:disabled) { filter: brightness(1.15) drop-shadow(0 0 10px rgba(41, 255, 201, 0.5)); }
  .forge:disabled { cursor: not-allowed; filter: grayscale(0.7) brightness(0.8); }
  .status { margin: 12px 0 0; min-height: 1.6em; font-style: italic; color: var(--ink-soft); }
  .status.error { color: var(--oxblood); font-style: normal; }

  [hidden] { display: none !important; }

  @media (max-width: 900px) {
    .workshop { grid-template-columns: 1fr; }
    .stage { position: static; }
    .arch { aspect-ratio: 1 / 1; max-height: 70vh; }
  }
  @media (max-width: 520px) {
    .layouts { grid-template-columns: 1fr; }
    .layout { grid-template-columns: 48px 1fr; justify-items: start; text-align: left; column-gap: 12px; }
    .layout svg { grid-row: span 2; }
    .sticker-opts { grid-template-columns: 1fr; }
  }
</style>
