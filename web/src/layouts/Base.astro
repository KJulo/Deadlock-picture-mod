---
import '@fontsource/grenze/600.css';
import '@fontsource/grenze/800.css';
import '@fontsource/barlow-condensed/600.css';
import '@fontsource/barlow-condensed/700.css';
import '@fontsource/jost/300.css';
import '@fontsource/jost/400.css';
import '@fontsource/jost/400-italic.css';
import '@fontsource/jost/500.css';
import '../styles/global.css';
import { SITE } from '../site.js';
import { languages, defaultLang, useDict, fmt, homeUrl, type Lang } from '../i18n/ui';

interface Props { title?: string }
const t = useDict(Astro.currentLocale);
const lang: Lang = Astro.currentLocale && Astro.currentLocale in languages
  ? (Astro.currentLocale as Lang)
  : defaultLang;
const { title = fmt(t.meta.title, { name: SITE.name }) } = Astro.props;
const canonicalUrl = Astro.site ? new URL(homeUrl(lang), Astro.site).href : undefined;
const ogImageUrl = Astro.site ? new URL('/og-preview.png', Astro.site).href : '/og-preview.png';
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={t.meta.description} />
    <meta name="theme-color" content="#121110" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {Astro.site && (
      [...(Object.keys(languages) as Lang[]), 'x-default'].map((l) => (
        <link rel="alternate" hreflang={l}
              href={new URL(homeUrl(l === 'x-default' ? defaultLang : (l as Lang)), Astro.site).href} />
      ))
    )}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'es_ES'} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={t.meta.description} />
    <meta name="twitter:image" content={ogImageUrl} />
  </head>
  <body>
    <slot />
  </body>
</html>
